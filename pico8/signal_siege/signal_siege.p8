pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
-- signal siege: silent vault
-- sprites 1-60: cards; 64-71: dungeon actors
cards={}
add(cards,{name="ping",tier=1,attack=4})
add(cards,{name="firewall",tier=1,shield=6})
add(cards,{name="tune",tier=1,focus=3})
add(cards,{name="beam",tier=1,attack=8})
add(cards,{name="repair",tier=1,heal=6})
add(cards,{name="burst",tier=1,attack=5,shield=3})
add(cards,{name="overdrive",tier=1,attack=12,cost=2})
add(cards,{name="relay",tier=1,shield=4,focus=2})
add(cards,{name="needle",tier=1,attack=3,poison=1})
add(cards,{name="static charge",tier=1,focus=2,shield=2})
add(cards,{name="scout drone",tier=1,drone=1})
add(cards,{name="patch kit",tier=1,heal=3,shield=2})
add(cards,{name="aegis",tier=1,shield=8})
add(cards,{name="echo shot",tier=1,attack=3,focus=2})
add(cards,{name="rust signal",tier=1,poison=2})
add(cards,{name="counterpulse",tier=1,thorns=2})
add(cards,{name="salvage sweep",tier=1,scrap=3})
add(cards,{name="ground wire",tier=1,weak=2,shield=2})
add(cards,{name="spark",tier=1,attack=5,weak=1})
add(cards,{name="beacon",tier=1,drone=1,focus=1})
add(cards,{name="hull plate",tier=1,shield=5,thorns=1})
add(cards,{name="quick fix",tier=1,heal=4,focus=1})
add(cards,{name="jammer",tier=1,weak=3})
add(cards,{name="tracker",tier=1,attack=2,drone=1})
add(cards,{name="ion lance",tier=2,attack=10,cost=1})
add(cards,{name="bulwark",tier=2,shield=10})
add(cards,{name="resonance",tier=2,focus=5})
add(cards,{name="medic drone",tier=2,drone=1,heal=4})
add(cards,{name="corrosion",tier=2,poison=4})
add(cards,{name="mirror array",tier=2,thorns=4,shield=3})
add(cards,{name="scrap cannon",tier=2,attack=4,salvage=2})
add(cards,{name="feedback",tier=2,attack=5,weak=2})
add(cards,{name="drone bay",tier=2,drone=2})
add(cards,{name="phase shift",tier=2,shield=5,weak=2})
add(cards,{name="arc flash",tier=2,attack=7,poison=2})
add(cards,{name="signal tap",tier=2,focus=3,scrap=2})
add(cards,{name="emergency patch",tier=2,heal=9,cost=1})
add(cards,{name="capacitor",tier=2,shield=4,focus=4})
add(cards,{name="siphon",tier=2,attack=4,heal=4})
add(cards,{name="disruptor",tier=2,weak=4,poison=1})
add(cards,{name="iron chorus",tier=2,shield=7,thorns=3})
add(cards,{name="hunter pulse",tier=2,attack=6,drone=1})
add(cards,{name="solar spear",tier=3,attack=14})
add(cards,{name="citadel",tier=3,shield=15})
add(cards,{name="harmonic engine",tier=3,focus=7,drone=1})
add(cards,{name="nanite swarm",tier=3,heal=8,drone=2})
add(cards,{name="void rot",tier=3,poison=6,cost=2})
add(cards,{name="retribution",tier=3,thorns=6,shield=5})
add(cards,{name="salvage reactor",tier=3,scrap=6,heal=3})
add(cards,{name="ghost fleet",tier=3,drone=3})
add(cards,{name="null field",tier=3,weak=6,shield=4})
add(cards,{name="life link",tier=3,attack=8,heal=6})
add(cards,{name="dawnbringer",tier=3,attack=16,heal=4})
add(cards,{name="worldshield",tier=3,shield=20,thorns=4})
add(cards,{name="infinite chorus",tier=4,focus=9,weak=3})
add(cards,{name="star forge",tier=4,drone=4,scrap=3})
add(cards,{name="event horizon",tier=4,attack=10,poison=6})
add(cards,{name="phoenix protocol",tier=4,heal=20,cost=3})
add(cards,{name="the last beacon",tier=4,drone=3,shield=10})
add(cards,{name="crown of static",tier=4,attack=10,weak=5,thorns=3})
-- persistent slots: 0 signature, 1-8 collection,
-- 9 best,10 salvage,11-30 run,31-42 deck,43-45 offers
function _init()
 anim=0 anim_result=0 anim_enemy=64
 cartdata("signal_siege_v1")
 owned={} for i=1,60 do owned[i]=0 end
 best=0 salvage=0 phase=0 sel=1 page=1
 room=1 px=7 py=5 cleared=0 looted=0 visited=1 message=""
 floorseed=1 rounds=0 miniondone=0 mobs={} mobroom=0
 face_x=0 face_y=-1 mobtick=0 hurt=0 slash=0
 if dget(0)==812 then
  for g=0,7 do
   local n=dget(1+g)
   for j=1,8 do
    local id=g*8+j
    if id<=60 then owned[id]=n%3 end
    n=flr(n/3)
   end
  end
  best=dget(9) salvage=dget(10)
  phase=dget(11)
  if phase>0 then
   depth=dget(12) hp=dget(13) shield=dget(14)
   focus=dget(15) power=dget(16) enemy=dget(17)
   hard=dget(18)==1 guardian=depth%6==0
   drone=dget(19) poison=dget(20) thorns=dget(21)
   scrap=dget(22) weak=dget(23)
   deck={} for i=1,dget(24) do add(deck,dget(30+i)) end
   offers={} for i=1,3 do add(offers,dget(42+i)) end
  end
 else
  owned[1]=1 owned[2]=1 owned[3]=1
 end
 if dget(46)==914 then
  room=dget(47) px=dget(48) py=dget(49)
  cleared=dget(50) looted=dget(51) visited=dget(52)
  floorseed=max(1,dget(53))
  rounds=dget(54) miniondone=dget(55)
  mobroom=dget(62)
  if mobroom==room then
   for i=1,2 do add(mobs,{x=dget(53+i*3),y=dget(54+i*3),hp=dget(55+i*3)}) end
  end
 elseif phase==2 or phase==3 then room=2 end
 if phase>0 then guardian=room==9 end
end
function save()
 dset(46,914) dset(47,room) dset(48,px) dset(49,py)
 dset(50,cleared) dset(51,looted) dset(52,visited) dset(53,floorseed) dset(54,rounds)
 dset(55,miniondone) dset(62,mobroom)
 if mobroom==room and #mobs==2 then
  for i=1,2 do local m=mobs[i] dset(53+i*3,m.x) dset(54+i*3,m.y) dset(55+i*3,m.hp) end
 end
 dset(0,812)
 for g=0,7 do
  local n=0 local m=1
  for j=1,8 do
   local id=g*8+j
   if id<=60 then n+=owned[id]*m end
   m*=3
  end
  dset(g+1,n)
 end
 dset(9,best) dset(10,salvage) dset(11,phase)
 if phase==0 then return end
 local vals={depth,hp,shield,focus,power,enemy,hard and 1 or 0,drone,poison,thorns,scrap,weak,#deck}
 for i,v in ipairs(vals) do dset(11+i,v) end
 for i,v in ipairs(deck) do dset(30+i,v) end
 for i=1,3 do dset(42+i,offers[i] or 1) end
end
function start(with_lore)
 depth=1 hp=30 shield=0 focus=0 power=0 enemy=0
 drone=0 poison=0 thorns=0 scrap=0 weak=0
 hard=false guardian=false deck={1,1,2,2,3,3}
 offers={} phase=1 sel=1
 new_floor()
 if with_lore then phase=5 end
 save()
end
function count(id)
 local n=0 for v in all(deck) do if v==id then n+=1 end end return n
end
function enemy_kind()
 if room==9 then return "vault warden" end
 return ({"iron brute","null jammer","hollow leech"})[(room+floorseed)%3+1]
end
function enemy_hit()
 local hit=2+flr(depth/4)+(hard and 1 or 0)+(guardian and 1 or 0)
 if enemy_kind()=="iron brute" then
  hit+=rounds%2==0 and -1 or 3
 end
 return max(0,hit-(weak>0 and 2 or 0))
end
function enemy_intent()
 local k=enemy_kind()
 return "hit "..enemy_hit()..(k=="null jammer" and " + drain 2 focus" or k=="hollow leech" and " + lifesteal" or k=="iron brute" and (rounds%2==0 and " (probe)" or " (slam)") or " + drain 1 focus")
end
function enemy_max()
 return min(30000,9+depth*2+(hard and 6 or 0)+(guardian and 10 or 0))
end
function enter(elite)
 hard=elite guardian=room==9
 enemy=enemy_max()
 drone=0 poison=0 thorns=0 weak=0 rounds=0
 phase=2 sel=1 save()
end
function rewards()
 offers={}
 local tiers=guardian and {3,3,4} or hard and {2,2,3} or {1,1,2}
 for tier in all(tiers) do
  local pool={} local fresh={}
  for id,c in ipairs(cards) do
   local used=false for v in all(offers) do if v==id then used=true end end
   if c.tier==tier and not used then
    add(pool,id) if owned[id]<2 then add(fresh,id) end
   end
  end
  add(offers,rnd(#fresh>0 and fresh or pool))
 end
 phase=3 sel=1
end
function play(slot)
 anim_hp_before=hp anim_enemy_before=enemy
 anim_enemy=enemy_kind()=="vault warden" and 66 or enemy_kind()=="null jammer" and 72 or enemy_kind()=="hollow leech" and 73 or 64
 local c
 if slot==4 then c={shield=5,focus=1}
 elseif slot==5 then c={heal=4}
 else
  local id=deck[slot] deli(deck,slot) add(deck,id) c=cards[id]
 end
 anim_name=c.name or (slot==4 and "guard" or "recover")
 anim_cast=(c.attack or c.poison or c.weak or c.drone or c.salvage) and "attack" or c.heal and "heal" or "ward"
 local damage=c.attack or 0
 if c.salvage then damage+=scrap*c.salvage scrap=0 end
 shield=min(24,shield+(c.shield or 0))
 focus=min(12,focus+(c.focus or 0))
 drone=min(6,drone+(c.drone or 0))
 poison=min(20,poison+(c.poison or 0))
 thorns=min(8,thorns+(c.thorns or 0))
 scrap=min(12,scrap+(c.scrap or 0))
 weak=min(12,weak+(c.weak or 0))
 hp=min(30,hp+(c.heal or 0))-(c.cost or 0)
 if damage>0 then enemy-=damage+focus+power focus=0 end
 enemy-=drone+poison poison=max(0,poison-1)
 anim_hp_action=hp anim_enemy_action=enemy
 if hp<=0 then phase=4
 elseif enemy<=0 then rewards()
 else
  local hit=enemy_hit()
  local injury=max(0,hit-shield)
  weak=max(0,weak-1) hp-=injury
  if enemy_kind()=="null jammer" then focus=max(0,focus-2) end
  if guardian then focus=max(0,focus-1) end
  if enemy_kind()=="hollow leech" then enemy+=min(3,injury) end
  rounds+=1
  shield=max(0,shield-hit) enemy-=thorns
  if hp<=0 then phase=4 elseif enemy<=0 then rewards() end
 end
 anim=48 anim_result=phase==3 and 1 or phase==4 and 2 or 0
 if phase==4 then
  local lost=flr((salvage+1)/2)
  salvage-=lost message="lost "..lost.." salvage"
 end
 save()
end
function descend()
 best=max(best,depth) depth=min(15000,depth+1)
 hp=min(30,hp+3) phase=1 sel=1 new_floor() save()
end
function take(id)
 anim=0
 if id then
  if owned[id]<2 then owned[id]+=1 else salvage=min(30000,salvage+1) end
  if count(id)<2 then
   if #deck>=12 then deli(deck,1) end
   add(deck,id)
  end
 end
 if guardian then power=min(1000,power+1) hp=30 end
 cleared=bor(cleared,shl(1,room-1))
 phase=1 sel=1 px=7 py=7 message="signal recovered!" save()
end
function _update()
 if anim>0 then anim-=1 return end
 if phase==5 then
  if btnp(4) then phase=1 save() end
  return
 end
 if archive then
  if btnp(0) then page=max(1,page-1) end
  if btnp(1) then page=min(60,page+1) end
  if btnp(5) then archive=false end
  return
 end
 if btnp(5) then archive=true return end
 if phase==1 then crawl_update() return end
 local n=phase==0 and 1 or phase==2 and 5 or phase==3 and 4 or 1
 if btnp(0) or btnp(2) then sel=(sel-2)%n+1 end
 if btnp(1) or btnp(3) then sel=sel%n+1 end
 if not btnp(4) then return end
 if phase==0 or phase==4 then start(true)
 elseif phase==2 then play(sel)
 elseif phase==3 then take(offers[sel]) end
end
function option(n,text,y)
 print((sel==n and "> " or "  ")..text,4,y,sel==n and 10 or 6)
end
function card(id,x,y)
 local c=cards[id] local col=({6,11,12,10})[c.tier]
 rectfill(x,y,x+117,y+75,1) rect(x,y,x+117,y+75,col)
 print(c.name,x+4,y+4,col)
 sspr((id%16)*8,flr(id/16)*8,8,8,x+5,y+16,32,32)
 local yy=y+16
 for k in all({"attack","shield","focus","heal","cost","drone","poison","thorns","scrap","salvage","weak"}) do
  if c[k] then print(k.." "..c[k],x+42,yy,7) yy+=7 end
 end
 print(({"common","uncommon","rare","legendary"})[c.tier].."  owned:"..owned[id].."/2",x+4,y+64,col)
end
function hp_bar(x,y,w,value,maximum)
 local v=max(0,value) local ratio=min(1,v/max(1,maximum))
 rectfill(x,y,x+w,y+4,5)
 if ratio>0 then rectfill(x,y,x+max(0,flr(w*ratio)-1),y+4,ratio<=.25 and 8 or ratio<=.5 and 9 or 11) end
 rect(x,y,x+w,y+4,6)
end
function battle_anim_draw()
 cls(1)
 print("signal keeper",4,5,12)
 print(enemy_kind(),66,5,8)
 local t=48-anim
 local ph=t<8 and anim_hp_before or t<26 and anim_hp_action or hp
 local eh=t<8 and anim_enemy_before or t<26 and anim_enemy_action or enemy
 hp_bar(4,16,48,ph,30) hp_bar(75,16,48,eh,enemy_max())
 print(max(0,ph).."/30",4,23,7)
 print(max(0,eh).."/"..enemy_max(),75,23,7)
 local px=20 local ex=96
 if t>=18 and t<30 and anim_result!=1 then ex-=flr((t-18)/2) end
 if t<16 then
  if anim_cast=="attack" then
   local bx=20+flr(min(1,t/10)*72)
   circfill(bx,53-flr((bx-20)/9),3,10)
   circ(bx,53-flr((bx-20)/9),5,9)
   if t>=10 then circ(ex+8,48,t-7,10) end
  elseif anim_cast=="heal" then
   for i=1,4 do
    local x=15+i*6 local y=66-(t+i*3)%20
    line(x-2,y,x+2,y,11) line(x,y-2,x,y+2,11)
   end
  else
   circ(27,57,6+flr(t/3),12)
   circ(27,57,3+flr(t/4),7)
  end
 end
 if t>=24 and t<32 and anim_result!=1 then
  line(ex,45,px+8,55,8)
  circ(px+4,55,flr((t-24)/2)+2,8)
 end
 if not (anim_cast=="attack" and t>=8 and t<16 and t%2==0) then spr(anim_enemy,ex,40,2,2) end
 rectfill(3,84,124,123,0) rect(3,84,124,123,13)
 local msg=t<16 and ("cast "..anim_name.."!") or t<34 and (anim_result==1 and "enemy defeated!" or "enemy strikes!") or (anim_result==1 and "victory! card recovered!" or anim_result==2 and "defeat... signal lost" or "prepare your next move")
 print(msg,8,96,anim_result==2 and 8 or 10)
 if t>=34 and anim_result==1 then
  for i=1,8 do pset((i*17+t*2)%120+4,18+(i*13+t)%56,10) end
 end
end
function _draw()
 cls(0)
 if anim>0 then battle_anim_draw() return end
 if phase==5 then lore_draw() return end
 if archive then
  print("archive "..page.."/60",4,4,10)
  card(page,5,18)
  print("left/right: browse",4,101,6)
  print("x: return",4,112,6) return
 end
 print("signal siege",4,3,10)
 if phase==0 then
  print("the endless silent vault",4,23,6)
  spr(64,48,42,2,2)
  print("60 cards to recover",4,70,7)
  print("best depth: "..best,4,82,6)
  option(1,"z: begin expedition",99)
 else
  print("depth:"..depth.." hp:"..max(0,hp).." sh:"..shield,4,12,7)
  if phase==1 then
   crawl_draw() return
  elseif phase==2 or phase==3 then
   if phase==2 then
    print(enemy_kind(),4,20,8)
    hp_bar(4,31,50,hp,30) hp_bar(73,31,50,enemy,enemy_max())
    print(max(0,hp).."/30",4,38,7)
    print(max(0,enemy).."/"..enemy_max(),73,38,7)
    print(enemy_intent(),4,49,9)
   else print("choose salvage (4=skip)",4,23,12) end
   if phase==2 then
    spr(enemy_kind()=="vault warden" and 66 or enemy_kind()=="null jammer" and 72 or enemy_kind()=="hollow leech" and 73 or 64,100,59,1,1)
    rectfill(4,80,123,108,1)
    local c=cards[deck[min(sel,3)]]
    print(sel<=3 and c.name or sel==4 and "guard" or "recover",8,84,10)
    if sel<=3 then
     local y=93
     for k in all({"attack","shield","heal","focus","poison","drone"}) do
      if c[k] then print(k.." "..c[k],8,y,7) y+=6 end
     end
    else print(sel==4 and "+5 shield / +1 focus" or "+4 hp; enemy still attacks",8,95,7) end
   else
    local id=offers[sel]
    if id then card(id,5,33) else print("leave salvage",10,60,6) end
   end
   print("< "..sel.."/"..(phase==2 and 5 or 4).." > focus:"..focus,4,112,10)
  else
   print("signal lost",30,45,8)
   print("half your salvage was lost",4,65,6)
   print("cards kept; expedition lost",4,75,6)
   option(1,"new expedition",92)
  end
 end
 print("z: select  x: archive",4,121,6)
end

-- each floor is a connected 3x3 network of rooms.
-- doors are always on the centre lines; cover never blocks them.
function new_floor()
 room=1 px=7 py=5 cleared=0 looted=0 visited=1
 miniondone=0 mobs={} mobroom=0
 floorseed=flr(rnd(30000))+1
 message="find the guardian and stairs"
end
function hasbit(bits,r)
 return band(bits,shl(1,r-1))!=0
end
function room_kind()
 if room==1 then return "entry" end
 if room==9 then return "guardian" end
 local n=(room*37+floorseed%101)%5
 return n==0 and "cache" or n==1 and "spring" or n==2 and "elite" or "sentinel"
end
function occupied()
 local k=room_kind()
 return k!="entry" and not hasbit(cleared,room)
end
function wall(x,y)
 if x<1 or x>13 or y<1 or y>9 then return true end
 if x==7 or y==5 then return false end
 local layout=(room+floorseed)%4
 if layout==0 then return (x==4 or x==10) and (y==3 or y==7) end
 if layout==1 then return (y==3 or y==7) and x>2 and x<12 end
 if layout==2 then return (x==4 or x==10) and y>1 and y<9 end
 return (x+y+floorseed)%7==0 and x>1 and x<13 and y>1 and y<9
end
function setup_mobs()
 if mobroom==room then return end
 mobroom=room mobs={{x=7,y=3,hp=2},{x=7,y=7,hp=2}}
 mobtick=0 hurt=0 slash=0
end
function minion_update()
 setup_mobs()
 if hurt>0 then hurt-=1 end
 if slash>0 then slash-=1 end
 if btnp(4) then
  slash=6
  for m in all(mobs) do
   if m.hp>0 and m.x==px+face_x and m.y==py+face_y then m.hp-=1 end
  end
  if mobs[1].hp<=0 and mobs[2].hp<=0 then
   miniondone=bor(miniondone,shl(1,room-1))
   message="boss revealed! approach it"
  else message="slash! face a minion" end
  save()
 end
 if hasbit(miniondone,room) then return end
 mobtick+=1
 if mobtick<15 then return end
 mobtick=0
 for m in all(mobs) do
  if m.hp>0 then
   local dx=sgn(px-m.x) local dy=sgn(py-m.y)
   local nx=m.x+dx local ny=m.y
   if dx==0 or wall(nx,ny) then nx=m.x ny=m.y+dy end
   if not wall(nx,ny) then m.x=nx m.y=ny end
   if m.x==px and m.y==py and hurt==0 then
    hp-=min(6,1+flr(depth/5)) hurt=30
    message="minion hit!"
    if hp<=0 then
     phase=4 salvage-=flr((salvage+1)/2)
    end
   end
  end
 end
 save()
end
function crawl_update()
 local fighting=occupied() and not hasbit(miniondone,room)
 if fighting then minion_update() if phase!=1 then return end end
 local dx=0 local dy=0
 if btnp(0) then dx=-1 elseif btnp(1) then dx=1
 elseif btnp(2) then dy=-1 elseif btnp(3) then dy=1 end
 if dx!=0 or dy!=0 then face_x=dx face_y=dy end
 local x=px+dx local y=py+dy
 local col=(room-1)%3 local row=flr((room-1)/3)
 local nextroom=room
 if y==5 and x==0 and col>0 then nextroom=room-1 x=13 end
 if y==5 and x==14 and col<2 then nextroom=room+1 x=1 end
 if x==7 and y==0 and row>0 then nextroom=room-3 y=9 end
 if x==7 and y==10 and row<2 then nextroom=room+3 y=1 end
 if nextroom!=room and occupied() then
  message="doors sealed: defeat the foe" return
 end
 if nextroom!=room then
  room=nextroom visited=bor(visited,shl(1,room-1))
  px=x py=y message=room_kind().." chamber" save() return
 end
 if not wall(x,y) then
  if occupied() and not fighting and x==7 and y==4 then
   enter(room_kind()=="elite") return
  end
  px=x py=y
 end
 if btnp(4) then
  local k=room_kind()
  if fighting then return end
  if occupied() and abs(px-7)+abs(py-4)<=1 then enter(k=="elite") return end
  if abs(px-7)+abs(py-5)<=1 then
   if (k=="spring" or k=="cache") and not hasbit(looted,room) then
    looted=bor(looted,shl(1,room-1))
    if k=="spring" then hp=min(30,hp+10) message="restored 10 integrity"
    else salvage=min(30000,salvage+2) message="found 2 salvage" end
   elseif room==9 and hasbit(cleared,9) then descend() return
   elseif room==1 and salvage>=3 then
    salvage-=3 hp=30 message="repair complete (-3 salvage)"
   else message="nothing to use here" end
  else message="stand near an object to use it" end
 end
 if dx!=0 or dy!=0 or btnp(4) then save() end
end
function lore_draw()
 cls(0)
 rect(2,2,125,125,5)
 print("the silent vault",20,9,10)
 line(12,19,115,19,13)
 local lines={
  "once, the relay carried",
  "voices between the stars.",
  "then the signal went dark.",
  "",
  "below the ruined tower,",
  "its guardians still obey",
  "a voice no one remembers.",
  "",
  "you are a signal keeper.",
  "recover the lost cards.",
  "break the wardens' hold.",
  "bring the voices home."
 }
 for i,t in ipairs(lines) do print(t,9,24+(i-1)*6,6) end
 print("z: descend into the vault",13,111,10)
end
function crawl_draw()
 cls(0)
 print("depth "..depth.." hp "..hp.." shield "..shield,3,2,7)
 local col=(room-1)%3 local row=flr((room-1)/3)
 for y=0,10 do for x=0,14 do
  local edge=x==0 or x==14 or y==0 or y==10
  local door=(y==5 and (x==0 and col>0 or x==14 and col<2)) or
   (x==7 and (y==0 and row>0 or y==10 and row<2))
  local solid=(edge and (not door or occupied())) or (not edge and wall(x,y))
  rectfill(x*8+4,y*8+13,x*8+11,y*8+20,solid and 5 or 1)
  if solid then line(x*8+4,y*8+13,x*8+11,y*8+13,13)
  elseif (x+y)%3==0 then pset(x*8+7,y*8+17,2) end
 end end
 local k=room_kind()
 if occupied() and not hasbit(miniondone,room) then
  setup_mobs()
  for m in all(mobs) do
   if m.hp>0 then spr(64,m.x*8+4,m.y*8+13) end
  end
 elseif occupied() then
  local kind=enemy_kind()
  local image=kind=="vault warden" and 66 or kind=="null jammer" and 72 or kind=="hollow leech" and 73 or 64
  spr(image,60,45)
  if k=="elite" then pset(63,43,10) end
 end
 if not occupied() and (k=="spring" or k=="cache") and not hasbit(looted,room) then spr(k=="spring" and 68 or 67,60,53) end
 if room==9 and hasbit(cleared,9) then spr(69,60,53) end
 if room==1 then spr(70,60,53) end
 if hurt%4<2 then spr(71,px*8+4,py*8+13) end
 if slash>0 then
  local sx=px*8+8+face_x*8 local sy=py*8+17+face_y*8
  circ(sx,sy,4,10)
 end
 -- minimap and current room
 for r=1,9 do
  local x=104+(r-1)%3*6 local y=15+flr((r-1)/3)*6
  rectfill(x,y,x+4,y+4,r==room and 10 or hasbit(visited,r) and 12 or 0)
 end
 print(k.." | room "..room,4,103,12)
 print(message,4,111,6)
 print("arrows move z slash/use x log",4,121,7)
end

